# Application mode must match on server and client.
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo

# Required when mode=supabase. Anon key is safe for browser use; RLS is mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Operations
APP_VERSION=local
LOG_LEVEL=info