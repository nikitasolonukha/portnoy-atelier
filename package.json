{
  "name": "portnoy-atelier",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "cross-env APP_MODE=demo NEXT_PUBLIC_APP_MODE=demo next dev",
    "build": "cross-env APP_MODE=demo NEXT_PUBLIC_APP_MODE=demo next build",
    "start": "cross-env APP_MODE=demo NEXT_PUBLIC_APP_MODE=demo PORT=3000 HOSTNAME=0.0.0.0 node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.project.config.ts",
    "standalone:check": "node scripts/check-standalone-runtime.mjs",
    "test:coverage": "vitest run --coverage --config vitest.project.config.ts",
    "test:e2e": "node scripts/run-demo-e2e.mjs",
    "test:e2e:supabase": "node scripts/run-supabase-e2e.mjs",
    "dev:supabase": "cross-env APP_MODE=supabase NEXT_PUBLIC_APP_MODE=supabase next dev",
    "build:supabase": "cross-env APP_MODE=supabase NEXT_PUBLIC_APP_MODE=supabase next build",
    "test:integration": "cross-env APP_MODE=demo vitest run --config vitest.integration.config.ts",
    "env:check": "node scripts/check-env.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node scripts/generate-db-types.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:integration && pnpm build && pnpm standalone:check",
    "container:up": "docker compose -p portnoy up -d --build app",
    "container:down": "docker compose -p portnoy down"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.18",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "10.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.1",
    "jsdom": "^27.0.0",
    "supabase": "2.115.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
